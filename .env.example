# 复制为 .env 并填入真实值（.env 不入库）
# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ===== SMTP（QQ 邮箱：设置->账户->开启SMTP服务->生成授权码） =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=yourname@qq.com
SMTP_AUTH_CODE=你的授权码
# MAIL_TO=收件邮箱（默认同 SMTP_USER）
# ===== 运行 =====
SEND_TIME=08:00
TOPIC_COUNT=10
DAILY_CALL_CAP=200
# ===== 社媒热榜（可选；需本地部署 DailyHotApi，见 README） =====
SOCIAL_ENABLED=false
# SOCIAL_API_BASE=http://localhost:6688
# SOCIAL_PLATFORMS=zhihu,weibo,douyin
# SOCIAL_COUNT=10

# ===== 手机推送（可选；日报送达后推送摘要到手机） =====
# PUSH_CHANNELS=bark,serverchan
# BARK_URL=https://api.day.app/<deviceKey>
# SERVERCHAN_SEND_KEY=SCTxxxx（sct.ftqq.com 获取，免费版 5 条/天）
